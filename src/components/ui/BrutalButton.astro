---
interface Props {
  href?: string;
  tone?: "primary" | "secondary";
  class?: string;
  target?: string;
  rel?: string;
  download?: string | boolean;
  "aria-disabled"?: boolean | "true" | "false";
  [key: string]: any;
}

const {
  href = "",
  tone = "primary",
  class: className = "",
  ...props
} = Astro.props;
---

<a
  class={`brutal-button brutal-button--${tone} ${className}`}
  href={href}
  {...props}
>
  <slot />
</a>

