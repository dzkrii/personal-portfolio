---
interface Props {
  as?: "h1" | "h2";
  description?: string;
  eyebrow?: string;
  id?: string;
  class?: string;
}

const {
  as: Heading = "h2",
  description,
  eyebrow,
  id,
  class: className = "",
} = Astro.props;
---

<header class={`section-heading ${className}`}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Heading id={id}><slot /></Heading>
  {description && <p class="section-heading__description">{description}</p>}
</header>

