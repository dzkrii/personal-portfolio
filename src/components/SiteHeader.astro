---
import { List, X } from "lucide-react";
import { navigation, siteConfig, type Locale } from "../data/site";

interface Props {
  currentPath?: string;
  locale?: Locale;
}

const { currentPath = "/", locale = "en" } = Astro.props;

function getHref(key: string) {
  if (locale === "id") {
    if (key === "home") return "/id";
    return `/id/${key}`;
  }
  if (key === "home") return "/";
  return `/${key}`;
}

function isActive(key: string, pathname: string) {
  const cleanPath = pathname.replace(/\/+$/, "") || "/";
  const href = getHref(key);
  if (href === "/" || href === "/id") return cleanPath === href;
  return cleanPath === href || cleanPath.startsWith(`${href}/`);
}

// Compute language switch target URL
const targetLocale: Locale = locale === "en" ? "id" : "en";
let switchHref = "/";
if (locale === "en") {
  if (currentPath === "/" || currentPath === "") {
    switchHref = "/id";
  } else {
    switchHref = `/id${currentPath.startsWith("/") ? currentPath : `/${currentPath}`}`;
  }
} else {
  const stripped = currentPath.replace(/^\/id(?=\/|$)/, "") || "/";
  switchHref = stripped;
}
---

<header class="site-header">
  <a
    class="github-badge"
    href={siteConfig.social.github}
    target="_blank"
    rel="noreferrer"
    aria-label="Buka profil GitHub dzkrii"
  >
    <span class="github-badge__mark" aria-hidden="true">
      <svg viewBox="0 0 24 24" role="img" focusable="false" width="20" height="20">
        <path
          fill="currentColor"
          d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.26c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.33-1.76-1.33-1.76-1.09-.75.08-.74.08-.74 1.2.08 1.83 1.24 1.83 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.77.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.95 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.62-2.81 5.64-5.49 5.94.43.37.81 1.1.81 2.22v3.28c0 .32.22.7.83.58A12 12 0 0 0 12 .5Z"
        />
      </svg>
    </span>
    <span class="github-badge__copy">
      <strong>dzkrii</strong>
      <small>Open source / profile</small>
    </span>
  </a>

  <button
    id="menu-toggle-btn"
    class="menu-button"
    type="button"
    aria-expanded="false"
    aria-controls="primary-navigation"
    aria-label="Menu"
  >
    <span class="menu-icon-open"><List aria-hidden="true" /></span>
    <span class="menu-icon-close" style="display: none;"><X aria-hidden="true" /></span>
  </button>

  <nav
    id="primary-navigation"
    class="nav"
    aria-label="Primary navigation"
  >
    {navigation.map((item) => (
      <a
        href={getHref(item.key)}
        aria-current={isActive(item.key, currentPath) ? "page" : undefined}
      >
        {item.label[locale]}
      </a>
    ))}

    <a
      href={switchHref}
      class="language-switcher"
      aria-label={locale === "en" ? "Ganti ke Bahasa Indonesia" : "Switch to English"}
      title={locale === "en" ? "Ganti ke Bahasa Indonesia" : "Switch to English"}
      data-target-locale={targetLocale}
    >
      {targetLocale.toUpperCase()}
    </a>
  </nav>
</header>

<script>
  function setupMenu() {
    const btn = document.getElementById("menu-toggle-btn");
    const nav = document.getElementById("primary-navigation");

    if (!btn || !nav) return;

    const toggleButton = btn;
    const primaryNav = nav;
    const iconOpen = toggleButton.querySelector(".menu-icon-open") as HTMLElement | null;
    const iconClose = toggleButton.querySelector(".menu-icon-close") as HTMLElement | null;

    let isOpen = false;

    function setOpen(state: boolean) {
      isOpen = state;
      toggleButton.setAttribute("aria-expanded", String(isOpen));
      toggleButton.setAttribute("aria-label", isOpen ? "Close menu" : "Menu");
      primaryNav.classList.toggle("nav--open", isOpen);
      if (iconOpen) iconOpen.style.display = isOpen ? "none" : "inline-block";
      if (iconClose) iconClose.style.display = isOpen ? "inline-block" : "none";
    }

    toggleButton.addEventListener("click", () => {
      setOpen(!isOpen);
    });

    // Close on any navigation link click
    primaryNav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });
  }

  function setupLanguageSwitcher() {
    const switchers = document.querySelectorAll(".language-switcher");
    switchers.forEach((el) => {
      el.addEventListener("click", () => {
        const target = el.getAttribute("data-target-locale");
        if (target) {
          localStorage.setItem("preferred-locale", target);
        }
      });
    });
  }

  // Setup on initial load and on Astro View Transitions navigation
  document.addEventListener("astro:page-load", () => {
    setupMenu();
    setupLanguageSwitcher();
  });
</script>
