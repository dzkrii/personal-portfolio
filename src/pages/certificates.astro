---
import BaseLayout from "../layouts/BaseLayout.astro";
import CertificatesExplorer from "../components/islands/CertificatesExplorer";
import { pageMeta } from "../data/site";

const locale = "en" as const;
const meta = pageMeta.certificates;
---

<BaseLayout
  title={meta.title[locale]}
  description={meta.description[locale]}
>
  <div class="certificates-page">
    <header class="certificates-header">
      <div class="section-badge-title">
        <h1 class="section-badge-title__text">Certificates</h1>
      </div>
    </header>

    <CertificatesExplorer client:idle locale={locale} />
  </div>
</BaseLayout>

