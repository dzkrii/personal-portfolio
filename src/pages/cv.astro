---
import BaseLayout from "../layouts/BaseLayout.astro";
import CvViewer from "../components/islands/CvViewer";
import { messages, pageMeta } from "../data/site";

const locale = "en" as const;
const meta = pageMeta.cv;
const t = messages[locale];
---

<BaseLayout
  title={meta.title[locale]}
  description={meta.description[locale]}
  locale={locale}
>
  <div class="cv-page">
    <header class="cv-header">
      <div class="section-badge-title">
        <h1 class="section-badge-title__text">{t.cvTitle}</h1>
      </div>
    </header>

    <p class="cv-intro-text">
      {t.cvSubtitle}
    </p>

    <CvViewer client:load initialLocale={locale} />
  </div>
</BaseLayout>
