---
import { ClientRouter } from "astro:transitions";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { messages, type Locale } from "../data/site";
import "../index.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  image?: string;
  preloadHeroImage?: boolean;
  locale?: Locale;
}

const SITE_URL = "https://fatahul.my.id";
const currentPath = Astro.url.pathname;

const {
  title = "Fatahul Ahmad Dzikri | Creative Developer",
  description = "Portfolio resmi Fatahul Ahmad Dzikri, Creative Developer & Software Developer dari Universitas Battuta. Spesialis modern web (React, Next.js, Laravel) dan mobile (Flutter).",
  canonical = new URL(currentPath, SITE_URL).href,
  noindex = false,
  image = "https://fatahul.my.id/fatahul-hero-illustration.png",
  preloadHeroImage = false,
  locale = "en",
} = Astro.props;

const robotsContent = noindex
  ? "noindex, follow"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://fatahul.my.id/#person",
      name: "Fatahul Ahmad Dzikri",
      alternateName: ["dzkrii", "kyuradev", "Fatahul", "Fatahul Ahmad"],
      jobTitle: ["Creative Developer", "Software Developer", "Web Developer"],
      description:
        "Mahasiswa Informatika di Universitas Battuta, Creative Developer dan Software Developer yang membangun aplikasi web modern (React, Next.js, TypeScript, Laravel) dan mobile (Flutter).",
      url: "https://fatahul.my.id",
      image: "https://fatahul.my.id/fatahul-hero-illustration.png",
      sameAs: [
        "https://github.com/dzkrii",
        "https://www.linkedin.com/in/fatahul-ahmad-dzikri/",
        "https://www.instagram.com/dzkrii_12",
        "https://www.youtube.com/@kyuradev",
        "https://www.tiktok.com/@kyuradev",
        "https://t.me/dzkkrii",
      ],
      affiliation: {
        "@type": "EducationalOrganization",
        name: "Universitas Battuta",
      },
      knowsAbout: [
        "Creative Development",
        "Web Development",
        "TypeScript",
        "JavaScript",
        "React",
        "Next.js",
        "Tailwind CSS",
        "PHP",
        "Laravel",
        "NestJS",
        "Express",
        "Flutter",
        "Dart",
        "UI/UX Design",
        "Software Engineering",
      ],
    },
    {
      "@type": "WebSite",
      "@id": "https://fatahul.my.id/#website",
      url: "https://fatahul.my.id",
      name: "Fatahul Ahmad Dzikri Portfolio",
      description:
        "Official portfolio of Fatahul Ahmad Dzikri, Creative Developer & Software Developer.",
      publisher: {
        "@id": "https://fatahul.my.id/#person",
      },
      inLanguage: ["id", "en"],
    },
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <script is:inline>
      (function () {
        try {
          var pref = localStorage.getItem("preferred-locale");
          var path = window.location.pathname;
          if (pref === "id" && (path === "/" || path === "")) {
            window.location.replace("/id");
          }
        } catch (e) {}
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Fatahul Ahmad Dzikri" />
    <meta
      name="keywords"
      content="Fatahul Ahmad Dzikri, Fatahul, dzkrii, kyuradev, Creative Developer, Web Developer Indonesia, Software Developer Universitas Battuta, React Developer, Next.js Developer, Portfolio Fatahul"
    />
    <meta name="robots" content={robotsContent} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f3f3ec" />
    <link rel="icon" type="image/svg+xml" href="/logo-fatahul.svg?v=2" />

    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/space-grotesk-latin-var.woff2"
      crossorigin
    />

    {
      preloadHeroImage && (
        <link
          rel="preload"
          as="image"
          href="/fatahul-hero-illustration-400.webp"
          imagesrcset="/fatahul-hero-illustration-400.webp 400w, /fatahul-hero-illustration-640.webp 640w, /fatahul-hero-illustration-800.webp 800w, /fatahul-hero-illustration.webp 1003w"
          imagesizes="(max-width: 47.99rem) min(100vw, 22.5rem), clamp(21.5rem, 28vw, 29rem)"
          type="image/webp"
          fetchpriority="high"
        />
      )
    }

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="Fatahul Ahmad Dzikri Portfolio" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:locale:alternate" content="en_US" />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Google tag (gtag.js) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-8ZGZFM88J7");

      (function () {
        var events = ["pointerdown", "keydown", "scroll", "touchstart"];
        var timer;
        var loaded = false;

        function loadGtag() {
          if (loaded) return;
          loaded = true;
          clearTimeout(timer);
          events.forEach(function (e) {
            window.removeEventListener(e, loadGtag);
          });

          var s = document.createElement("script");
          s.async = true;
          s.src = "https://www.googletagmanager.com/gtag/js?id=G-8ZGZFM88J7";
          document.head.appendChild(s);
        }

        function schedule() {
          events.forEach(function (e) {
            window.addEventListener(e, loadGtag, { once: true, passive: true });
          });
          timer = setTimeout(loadGtag, 4000);
        }

        if (document.readyState === "complete") schedule();
        else window.addEventListener("load", schedule, { once: true });
      })();
    </script>

    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      {messages[locale].skip}
    </a>
    <div class="site-shell">
      <SiteHeader currentPath={currentPath} locale={locale} />
      <main id="main-content">
        <slot />
      </main>
      <SiteFooter locale={locale} />
    </div>
  </body>
</html>

